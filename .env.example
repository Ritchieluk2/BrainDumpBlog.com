# Copy this file to .env and fill in the values. Never commit .env.

# Encrypts the session cookie. Required: at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Do not leave this set to an empty value, or sign-in will fail with "Empty password".
NUXT_SESSION_PASSWORD=paste-generated-value-here

# Resend (https://resend.com/api-keys). Leave empty in development to print
# sign-in links to the terminal instead of emailing them.
NUXT_RESEND_API_KEY=

# Who sign-in emails come from. Until you verify your own domain in Resend,
# onboarding@resend.dev only delivers to the email on your Resend account.
NUXT_EMAIL_FROM="Brain Dump <onboarding@resend.dev>"

# Public address of the site, used to build sign-in links.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Accounts that see everyone's game stats (comma-separated). Optional.
NUXT_ADMIN_EMAILS=

